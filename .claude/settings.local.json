{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(fuser -k 3000/tcp)",
      "Bash(nohup pnpm *)",
      "Bash(curl -sI http://localhost:3000)",
      "Bash(curl -s \"http://localhost:3000?cb=$\\(date +%s\\)\")"
    ]
  },
  "enabledMcpjsonServers": [
    "mongodb",
    "playwright"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"At the end of every reply, append a footer block on its own line:\\n\\nDashboard: http://95.81.118.170:3000  ·  API docs: http://95.81.118.170:8000/docs\"}}'"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a' 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'; sleep 0.3; printf '\\a' 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  }
}
