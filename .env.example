# MongoDB root (admin) — only for initial setup, not used by the app
MONGO_USER=admin
MONGO_PASSWORD=change_me

# MongoDB app user — used by FastAPI
MONGO_APP_USER=rates_user
MONGO_APP_PASSWORD=change_me

# Connection string for FastAPI (Motor)
MONGO_URL=mongodb://rates_user:change_me@localhost:27017/rates

# Redis
REDIS_URL=redis://localhost:6379/0

# Google Analytics 4 measurement ID. Read at `docker compose build web` time,
# not at runtime — rebuild the web image after changing it. Leave empty to ship
# the dashboard without any analytics.
NEXT_PUBLIC_GA_ID=

# Same-origin prefix that Caddy proxies to Google, so ad-blockers can't kill
# analytics by domain. Must match the @ga_* matchers in caddy/Caddyfile.
# Leave empty to load gtag.js straight from googletagmanager.com.
NEXT_PUBLIC_GA_PROXY=/mx
