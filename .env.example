# MongoDB root (admin) — only for initial setup, not used by the app
MONGO_USER=admin
MONGO_PASSWORD=change_me

# MongoDB app user — used by FastAPI
MONGO_APP_USER=rates_user
MONGO_APP_PASSWORD=change_me

# Connection string for FastAPI (Motor)
MONGO_URL=mongodb://rates_user:change_me@localhost:27017/rates

# Redis
REDIS_URL=redis://localhost:6379/0
