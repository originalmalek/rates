esimspotter.com {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle /r/* {
		reverse_proxy 127.0.0.1:8001
	}

	# First-party proxy for Umami Cloud so ad-blockers (EasyPrivacy/uBlock,
	# which block cloud.umami.is and /api/send) can't kill analytics. The
	# tracker loads from /stats/script.js and posts to /stats/api/send
	# (data-host-url in AnalyticsScripts.tsx); Caddy strips /stats and forwards
	# both to cloud.umami.is. Not /api/* because that's already the backend.
	handle_path /stats/* {
		reverse_proxy https://cloud.umami.is {
			header_up Host cloud.umami.is
		}
	}

	reverse_proxy 127.0.0.1:3001

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

www.esimspotter.com {
	redir https://esimspotter.com{uri} permanent
}

# Dev/staging mirror of the redesign. Shares the prod API (:8001); the frontend
# is a separate build on :3005 (deploy/deploy-web-dev.sh, tmux esim_frontend_dev)
# with SITE_URL=https://dev.esimspotter.com + NOINDEX=1. The X-Robots-Tag here is
# a third layer of noindex (alongside robots.txt and per-page <meta>), covering
# assets/non-HTML responses too. Requires a DNS A record dev -> server IP before
# Caddy can issue its certificate.
dev.esimspotter.com {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle /r/* {
		reverse_proxy 127.0.0.1:8001
	}

	reverse_proxy 127.0.0.1:3005

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

notyour.best {
	encode zstd gzip
	root * /srv/sites/notyour-best
	# Fonts are static & self-hosted — cache them hard; everything else stays no-cache.
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@nofont not path /fonts/*
	header @nofont Cache-Control "no-cache"
	@git path /.git*
	handle @git {
		respond 404
	}

	# Same first-party GA proxy as rates.notyour.best below — see the long
	# comment there. Must precede the file_server handle: `handle` blocks are
	# mutually exclusive and matched in source order, so a catch-all first
	# would swallow /mx and return 404 from the static root.
	@ga_loader path /mx/l.js
	handle @ga_loader {
		rewrite * /gtag/js
		reverse_proxy https://www.googletagmanager.com {
			header_up Host www.googletagmanager.com
		}
	}

	@ga_collect path /mx/g/collect*
	handle @ga_collect {
		uri strip_prefix /mx
		reverse_proxy https://www.google-analytics.com {
			header_up Host www.google-analytics.com
		}
	}

	handle {
		file_server
	}
}

www.notyour.best {
	redir https://notyour.best{uri} permanent
}

