# Rates dashboard — FastAPI backend on :8000, Next.js frontend on :3000
# (tmux: rates_api / rates_worker / rates_frontend in /home/sergey/rates).
rates.notyour.best {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# First-party proxy for GA4 so ad-blockers (very common in a DeFi audience)
	# can't kill it by blocking googletagmanager.com / google-analytics.com.
	# The /mx prefix is deliberately neutral — "gtag"/"analytics" in a path is
	# itself a filter-list signature. Must stay in sync with
	# NEXT_PUBLIC_GA_PROXY. Two upstreams because gtag.js loads from
	# googletagmanager but beacons to google-analytics; the /g/collect suffix
	# is appended by gtag.js itself and can't be renamed.
	@ga_loader path /mx/l.js
	handle @ga_loader {
		rewrite * /gtag/js
		reverse_proxy https://www.googletagmanager.com {
			header_up Host www.googletagmanager.com
		}
	}

	@ga_collect path /mx/g/collect*
	handle @ga_collect {
		uri strip_prefix /mx
		reverse_proxy https://www.google-analytics.com {
			header_up Host www.google-analytics.com
		}
	}

	reverse_proxy 127.0.0.1:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

